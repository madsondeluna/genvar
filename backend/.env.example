REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600
ENSEMBL_MAX_VARIANTS=500
GNOMAD_DATASET=gnomad_r4
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Identificacao exigida pelo NCBI em toda chamada ao E-utilities. Sem ela eles
# bloqueiam a origem sem aviso, porque nao tem a quem escrever antes.
NCBI_EMAIL=madsondeluna@gmail.com
# Opcional. Sobe o teto de 3 para 10 requisicoes por segundo.
# Gerada em https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# Limite por IP na API publica. Zero desliga.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_SECOND=10
# Proxies entre o cliente e a aplicacao. Render poe um; local, sem proxy, e zero.
TRUSTED_PROXY_HOPS=1
