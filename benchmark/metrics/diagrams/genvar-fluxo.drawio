<mxfile host="app.diagrams.net"><diagram name="genvar-fluxo" id="genvar-fluxo"><mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;GET /api/gene/{símbolo}&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="200" height="46" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Backend valida o símbolo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#222222;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="180" y="150" width="240" height="54" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;Em cache?&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;(Redis)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="235" y="240" width="130" height="104" as="geometry"/></mxCell><mxCell id="hit" value="&lt;b&gt;Resposta do cache&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;entrega imediata&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="262" width="160" height="58" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Ensembl&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;lookup do gene → gene_id (sequencial)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#222222;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="180" y="390" width="240" height="58" as="geometry"/></mxCell><mxCell id="bar" value="&lt;b&gt;asyncio.gather&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;chamadas em paralelo&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#222222;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="120" y="486" width="360" height="40" as="geometry"/></mxCell><mxCell id="pA" value="&lt;b&gt;Ensembl&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;overlap de variantes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#222222;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="30" y="576" width="190" height="66" as="geometry"/></mxCell><mxCell id="pB" value="&lt;b&gt;gnomAD&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;restrição do gene&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#222222;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="240" y="576" width="190" height="66" as="geometry"/></mxCell><mxCell id="pC" value="&lt;b&gt;UniProt&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;identificador&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#222222;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="450" y="576" width="190" height="66" as="geometry"/></mxCell><mxCell id="pD" value="&lt;b&gt;AlphaFold&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;estrutura 3D&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#222222;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="450" y="700" width="190" height="66" as="geometry"/></mxCell><mxCell id="agg" value="&lt;b&gt;Agrega, classifica e prioriza variantes&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;(no servidor)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5